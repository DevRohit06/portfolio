---
import { type Props as SEOProps, SEO as AstroSEO } from "astro-seo";
import { getBaseUrl, getCanonicalUrl } from "../lib/baseUrl";

import { mainMetaData } from "../lib/metaData";

interface Props extends SEOProps {
  imageUrl?: string;
  type?: "article" | "website" | "profile";
  slot: "seo";
  canonicalPath?: string;
  isAlternate?: boolean;
  primaryCanonicalPath?: string; // For alternate pages to point to the main canonical
  noindex?: boolean; // For preventing soft 404s or duplicate content issues
}

const { props } = Astro;
const baseUrl = getBaseUrl();

const metaData = {
  title: props.title ?? mainMetaData.title,
  description: props.description ?? mainMetaData.description,
  image: props.imageUrl ?? `images/og.webp`,
};

// Build canonical URL with improved handling
let canonicalUrl;
if (props.isAlternate && props.primaryCanonicalPath) {
  // If this is an alternate page, use the provided primary canonical URL
  canonicalUrl = getCanonicalUrl(props.primaryCanonicalPath);
} else if (props.canonicalPath) {
  // If a specific canonical path is provided, use it
  canonicalUrl = getCanonicalUrl(props.canonicalPath);
} else {
  // Default: Use current path, with special handling for the homepage
  canonicalUrl =
    Astro.url.pathname === "/"
      ? getCanonicalUrl()
      : getCanonicalUrl(Astro.url.pathname);
}

const defaultProps: SEOProps = {
  title: metaData.title,
  titleDefault: metaData.title,
  description: metaData.description,
  canonical: canonicalUrl,
  openGraph: {
    basic: {
      image: metaData.image,
      title: metaData.title,
      type: props.type ?? "website",
      url: canonicalUrl, // Use canonical URL for OpenGraph as well for consistency
      ...props.openGraph?.basic,
    },
    optional: {
      siteName: mainMetaData.title,
      description: metaData.description,
      ...props.openGraph?.optional,
    },
  },
  twitter: {
    title: metaData.title,
    description: metaData.description,
    creator: "@rohitk_06",
    card: "summary_large_image",
    image: metaData.image,
    imageAlt: metaData.title,
  },
  extend: {
    meta: [
      { name: "author", content: "Rohit Kushwaha" },
      {
        name: "keywords",
        content:
          "Rohit Kushwaha, Rohit Kushwaha AI engineer, Rohit Kushwaha developer, AI Engineer, Full-Stack Developer, AI agents, generative UI, AI developer tooling, open source, PocketPaw, discli, Lito, Svelte, React, Next.js, Python, Node.js, AI engineer Ambernath, AI engineer Badlapur, AI engineer Ulhasnagar, AI engineer Kalyan, AI engineer Dombivli, AI engineer Thane, Mumbai",
      },
      // Add noindex tag for pages that should be excluded from search engines
      ...(props.noindex
        ? [
            { name: "robots", content: "noindex, nofollow" },
            { name: "googlebot", content: "noindex, nofollow" },
          ]
        : []),
      ...(props.extend?.meta || []),
    ],
    link: [
      // Canonical is emitted by astro-seo via the `canonical` prop above.
      // Do NOT add a second rel="canonical" here or pages get duplicate tags.
      ...(props.extend?.link || []),
    ],
  },
};

const combinedProps = { ...defaultProps, ...props };

// Build BreadcrumbList structured data for non-home pages.
// Helps search engines and AI answer engines understand the site hierarchy.
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbList = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: baseUrl },
    ...pathSegments.map((segment, index) => ({
      "@type": "ListItem",
      position: index + 2,
      name: decodeURIComponent(segment)
        .replace(/-/g, " ")
        .replace(/\b\w/g, (c) => c.toUpperCase()),
      item: getCanonicalUrl("/" + pathSegments.slice(0, index + 1).join("/")),
    })),
  ],
};
---

<AstroSEO {...combinedProps} />

<!-- Add JSON-LD structured data for Person -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Rohit Kushwaha",
    alternateName: "Rohit Kushwaha (DevRohit06)",
    url: baseUrl,
    image: `${baseUrl}/images/rohit.webp`,
    jobTitle: "AI Engineer & Full-Stack Developer",
    worksFor: {
      "@type": "Organization",
      name: "Qbtrix",
      url: "https://qbtrix.com",
    },
    address: {
      "@type": "PostalAddress",
      addressLocality: "Ambernath",
      addressRegion: "Maharashtra",
      addressCountry: "India",
    },
    homeLocation: {
      "@type": "Place",
      name: "Ambernath, Thane district, Maharashtra, India",
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: "Mumbai Metropolitan Region",
      },
    },
    nationality: "Indian",
    sameAs: [
      "https://github.com/DevRohit06",
      "https://www.linkedin.com/in/rohitk06/",
      "https://twitter.com/rohitk_06",
      "https://www.instagram.com/rohitk.06/",
    ],
    description:
      "Rohit Kushwaha is an AI engineer and full-stack developer based in Ambernath, Maharashtra, India (Thane district, Mumbai region), near Badlapur, Ulhasnagar, Kalyan and Dombivli. He builds AI agents, generative UI and developer tools: he is a core contributor to the open-source AI-agent platform PocketPaw, works on the ripple-iui generative UI framework and soul-protocol at Qbtrix, and created discli and Lito. He builds end to end across Svelte, React, Next.js, Python, and Node.js.",
    knowsAbout: [
      "AI Engineering",
      "AI Agents",
      "Generative UI",
      "LLM Applications",
      "Model Context Protocol (MCP)",
      "Full-Stack Development",
      "AI Developer Tooling",
      "Svelte",
      "SvelteKit",
      "React",
      "Next.js",
      "Astro",
      "TypeScript",
      "Python",
      "Node.js",
      "Open Source",
    ],
  })}
/>

<!-- Add JSON-LD structured data for WebSite -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    url: baseUrl,
    name: mainMetaData.title,
    description: mainMetaData.description,
    keywords:
      "Rohit Kushwaha, AI Engineer, Full-Stack Developer, AI agents, AI developer tooling, open source, Svelte, React, Next.js, Python, Ambernath, Thane, Mumbai",
    author: {
      "@type": "Person",
      name: "Rohit Kushwaha",
      jobTitle: "AI Engineer & Full-Stack Developer",
    },
  })}
/>

<!-- BreadcrumbList structured data (only for pages below the homepage) -->
{
  pathSegments.length > 0 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbList)}
    />
  )
}
